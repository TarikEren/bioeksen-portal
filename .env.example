# Copy this file to `.env` and set the values. Do not commit `.env`.
# This file holds placeholders only. A secret is never written here (sds-config).
# The list follows FND-03 (docs/specs/core.md) and sds-auth (credentials.md,
# Configuration). Each name carries its rule: required, optional, or the
# condition under which the setting is required.

# A line that starts with `#` and holds a setting is an optional setting, or one
# that only production requires. Remove the `#` to set it. An empty value is not
# the same as an unset value.

# --- Application ---------------------------------------------------------

# required: development, test, demo or production. The demo (DEC-135) runs from
# compose.demo.yaml, which sets it, and applies each rule of production except
# that the ENTRA_* settings below may all stay unset.
APP_ENV=development

# required: the public origin of the app (FND-07 rule 3 compares Origin to it)
PUBLIC_BASE_URL=http://localhost:3000

# required in production and in the demo: the proxy addresses, comma separated
# (DEC-038). compose.demo.yaml sets 127.0.0.1 when this is not set
# TRUSTED_PROXIES=

# optional: DEBUG, INFO, WARNING, ERROR or FATAL (default INFO)
# LOG_LEVEL=INFO

# optional: true opens the test seams. APP_ENV production refuses it (FND-03 rule 4)
# TEST_SEAMS_ENABLED=false

# optional: only the command of ACC-40 reads it
# BOOTSTRAP_ADMIN_EMAIL=

# --- Database and cache --------------------------------------------------

# required: PostgreSQL 16 connection string (the development database)
DATABASE_URL=postgresql://bioeksen:change-me@localhost:5432/bioeksen_portal_dev

# required: Redis 7 connection string
REDIS_URL=redis://localhost:6379

# --- Object store (S3 compatible) ----------------------------------------

# required
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bioeksen-portal
# required, secret. The demo gives these to MinIO as its root user. MinIO wants
# at least 3 characters for the id and 8 for the secret. Use letters, digits
# and hyphens (the demo writes them into a URL). Change both placeholders.
S3_ACCESS_KEY_ID=change-me-access-key
S3_SECRET_ACCESS_KEY=change-me-secret-key
# optional: the endpoint of signed download URLs (DEC-132). Default: S3_ENDPOINT_URL
# S3_PUBLIC_ENDPOINT_URL=

# --- Mail relay ----------------------------------------------------------

# required (the development relay is Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev
# required, secret (Mailpit takes any value). Change the placeholder
SMTP_PASSWORD=change-me
MAIL_FROM=portal@example.invalid

# --- e-IFU ---------------------------------------------------------------

# required
EIFU_LEGAL_NOTICE_VERSION=draft-1
# required in production and in the demo, secret: id:base64key pairs, comma
# separated, newest first; each key decodes to 32 bytes and each id is there
# once (IFU-90). The placeholder below is 32 zero bytes. Make a key with
# `openssl rand -base64 32`
EIFU_IDENTITY_KEYS=demo-1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# required in production and in the demo, secret: at least 32 characters
# (IFU-90). Change the placeholder
EIFU_IDENTITY_LOOKUP_PEPPER=change-me-pepper-change-me-pepper-change-me
# optional: days an access record keeps its identity fields. Default 3653. 0 stops the pass (DEC-080)
# EIFU_ACCESS_RECORD_RETENTION_DAYS=

# --- Authentication (sds-auth, credentials.md, Configuration) -------------

# required, unless APP_ENV is demo and none of the ENTRA_* settings is set. In
# the demo without them, GET /api/health and GET /api/admin/logs answer 503
# AUTH-5500 and the app still reports ready (DEC-135). Set all of them or none.
# ENTRA_TENANT_ID=
# ENTRA_ISSUER=
# ENTRA_JWKS_URI=
# ENTRA_JWKS_MAX_AGE_SECONDS=3600
# ENTRA_AUDIENCE=
# ENTRA_CLIENT_ID=
# ENTRA_OPERATOR_SCOPE=
# required with them: one of the two client credentials
# ENTRA_CLIENT_CERTIFICATE_PATH=
# secret
# ENTRA_CLIENT_SECRET=
# optional: default 60
# AUTH_CLOCK_SKEW_SECONDS=60

# --- Local services (compose.dev.yaml and compose.demo.yaml; the app does not read these) ---

POSTGRES_USER=bioeksen
# secret. Letters, digits and hyphens only (the demo writes it into DATABASE_URL). Change the placeholder
POSTGRES_PASSWORD=change-me
# compose.dev.yaml only; the demo has its own database, bioeksen_portal_demo
POSTGRES_DB=bioeksen_portal_dev
# compose.dev.yaml only
POSTGRES_PORT=5432
# compose.dev.yaml only
REDIS_PORT=6379
# the host ports, on the loopback address (both compose files)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025
# compose.demo.yaml only: the host port of the app. PUBLIC_BASE_URL above must
# name the same port
APP_PORT=3000

# --- Tests only (the app does not read these) ------------------------------

# The disposable database of the integration suite. The name ends in
# `_integration` (FND-06 rule 4). Use one database for each worktree:
# bioeksen_portal_<role>_integration. It is never the DATABASE_URL database.
TEST_DATABASE_URL=postgresql://bioeksen:change-me@localhost:5432/bioeksen_portal_main_integration
# The disposable database of the end-to-end suite. The name ends in `_e2e`.
TEST_E2E_DATABASE_URL=postgresql://bioeksen:change-me@localhost:5432/bioeksen_portal_main_e2e
# Hosts a suite may reset a database on, comma separated. Default: loopback only.
TEST_DATABASE_HOSTS=localhost,127.0.0.1
# The port of the end-to-end app (one port for each worktree)
E2E_PORT=3100
