// use prisma-8

// platform_log_record: the local store of the in-app logger (DEC-127, FND-04
// rule 3, FND-05). GET /api/admin/logs reads this table.
//
// The named checks keep the closed sets of log-record.md and the length of the
// message (FND-05). The indexes serve GET /api/admin/logs: the page order
// (timestamp, then the row id; PostgreSQL reads it backward and sorts the ties
// of one timestamp by the row id), the filter by code, and the filter by type
// and severity. The contract cannot hold a descending key: db verify reads an
// index with a sort direction as a different index. The function platform_refuse_delete() is a rawSql operation
// of the migration that adds these (DEC-005), because the contract cannot hold a
// function.
model PlatformLogRecord {
  id         BigInt                @id @default(autoincrement())
  softwareId String                @map("software_id")
  timestamp  TimestamptzString(3)
  severity   String
  type       String
  code       String?
  message    String
  shippedAt  TimestamptzString?    @map("shipped_at")

  @@check(expression: sql`(severity = ANY (ARRAY['DEBUG'::text, 'INFO'::text, 'WARNING'::text, 'ERROR'::text, 'FATAL'::text]))`, map: "log_record_severity_is_known")
  @@check(expression: sql`(type = ANY (ARRAY['APP'::text, 'SECURITY'::text, 'AUDIT'::text, 'ACCESS'::text, 'JOB'::text]))`, map: "log_record_type_is_known")
  @@check(expression: sql`(char_length(message) <= 8192)`, map: "log_record_message_length")
  @@index([timestamp, id], map: "platform_log_record_timestamp_id_idx")
  @@index([code], map: "platform_log_record_code_idx")
  @@index([type, severity], map: "platform_log_record_type_severity_idx")
  @@map("platform_log_record")
}

// identity_user: one person, one account (ACC-10, DEC-023). `email_normalized`
// holds the email address in lower case and is unique, so the address is unique
// without regard to letter case (ACC-10.AC2). `password_hash` is null until the
// person opens the invitation (ACC-10.AC1), and then holds a `scrypt` hash
// (DEC-129). The row is never deleted (DEC-010): the triggers of the migration
// `identity_and_audit` refuse DELETE and TRUNCATE.
model IdentityUser {
  id                BigInt                @id @default(autoincrement())
  email             String
  emailNormalized   String                @unique(map: "identity_user_email_unique") @map("email_normalized")
  firstName         String                @map("first_name")
  lastName          String                @map("last_name")
  preferredLanguage String                @map("preferred_language")
  isActive          Boolean               @default(true) @map("is_active")
  passwordHash      String?               @map("password_hash")
  passwordChangedAt TimestamptzString(3)? @map("password_changed_at")
  createdAt         TimestamptzString(3)  @map("created_at")
  updatedAt         TimestamptzString(3)  @map("updated_at")

  tokens             IdentityAuthToken[]      @relation("TokenUser")
  createdTokens      IdentityAuthToken[]      @relation("TokenCreator")
  assignments        IdentityRoleAssignment[] @relation("AssignmentUser")
  grantedAssignments IdentityRoleAssignment[] @relation("AssignmentGranter")
  revokedAssignments IdentityRoleAssignment[] @relation("AssignmentRevoker")

  @@check(expression: sql`(preferred_language = ANY (ARRAY['tr'::text, 'en'::text]))`, map: "identity_user_preferred_language_is_known")
  @@check(expression: sql`(email_normalized = lower(email_normalized))`, map: "identity_user_email_normalized_is_lower")
  @@map("identity_user")
}

// identity_auth_token: an invitation link or a reset link (ACC-10 rule 2,
// ACC-11, DEC-123). The row keeps the SHA-256 of the token, never the token.
// A user has one unused token for each purpose (partial unique index).
model IdentityAuthToken {
  id              BigInt                @id @default(autoincrement())
  userId          BigInt                @map("user_id")
  purpose         String
  tokenHash       String                @unique(map: "identity_auth_token_hash_unique") @map("token_hash")
  expiresAt       TimestamptzString(3)  @map("expires_at")
  usedAt          TimestamptzString(3)? @map("used_at")
  endedAt         TimestamptzString(3)? @map("ended_at")
  createdByUserId BigInt?               @map("created_by_user_id")
  createdAt       TimestamptzString(3)  @map("created_at")

  user      IdentityUser  @relation("TokenUser", fields: [userId], references: [id], map: "identity_auth_token_user_fk")
  createdBy IdentityUser? @relation("TokenCreator", fields: [createdByUserId], references: [id], map: "identity_auth_token_created_by_fk")

  @@check(expression: sql`(purpose = ANY (ARRAY['INVITATION'::text, 'PASSWORD_RESET'::text]))`, map: "identity_auth_token_purpose_is_known")
  @@index([userId, purpose], where: sql`((used_at IS NULL) AND (ended_at IS NULL))`, unique: true, map: "identity_auth_token_one_unused_unique")
  @@map("identity_auth_token")
}

// identity_permission: the permission registry of ACC-30. Bootstrap fills it.
model IdentityPermission {
  id   BigInt @id @default(autoincrement())
  code String @unique(map: "identity_permission_code_unique")

  roles IdentityRolePermission[]

  @@map("identity_permission")
}

// identity_role: a named bundle of permissions (DEC-029). `name` holds the name
// in both languages (DEC-011).
model IdentityRole {
  id   BigInt @id @default(autoincrement())
  code String @unique(map: "identity_role_code_unique")
  name Jsonb

  permissions IdentityRolePermission[]
  assignments IdentityRoleAssignment[]

  @@check(expression: sql`((jsonb_typeof(name) = 'object'::text) AND (jsonb_typeof((name -> 'tr'::text)) = 'string'::text) AND (jsonb_typeof((name -> 'en'::text)) = 'string'::text))`, map: "identity_role_name_has_both_languages")
  @@map("identity_role")
}

model IdentityRolePermission {
  id           BigInt @id @default(autoincrement())
  roleId       BigInt @map("role_id")
  permissionId BigInt @map("permission_id")

  role       IdentityRole       @relation(fields: [roleId], references: [id], map: "identity_role_permission_role_fk")
  permission IdentityPermission @relation(fields: [permissionId], references: [id], map: "identity_role_permission_permission_fk")

  @@unique([roleId, permissionId], map: "identity_role_permission_pair_unique")
  @@map("identity_role_permission")
}

// identity_role_assignment: a grant of a role to a user (ACC-31). A revoked
// assignment stays with `is_active` false (DEC-010). A user holds a role once
// at a time (partial unique index). The triggers of the migration refuse DELETE
// and TRUNCATE.
model IdentityRoleAssignment {
  id              BigInt                @id @default(autoincrement())
  userId          BigInt                @map("user_id")
  roleId          BigInt                @map("role_id")
  isActive        Boolean               @default(true) @map("is_active")
  grantedByUserId BigInt?               @map("granted_by_user_id")
  grantedAt       TimestamptzString(3)  @map("granted_at")
  revokedByUserId BigInt?               @map("revoked_by_user_id")
  revokedAt       TimestamptzString(3)? @map("revoked_at")

  user      IdentityUser  @relation("AssignmentUser", fields: [userId], references: [id], map: "identity_role_assignment_user_fk")
  role      IdentityRole  @relation(fields: [roleId], references: [id], map: "identity_role_assignment_role_fk")
  grantedBy IdentityUser? @relation("AssignmentGranter", fields: [grantedByUserId], references: [id], map: "identity_role_assignment_granted_by_fk")
  revokedBy IdentityUser? @relation("AssignmentRevoker", fields: [revokedByUserId], references: [id], map: "identity_role_assignment_revoked_by_fk")

  @@index([userId, roleId], where: sql`is_active`, unique: true, map: "identity_role_assignment_one_active_unique")
  @@index([userId], map: "identity_role_assignment_user_idx")
  @@map("identity_role_assignment")
}

// platform_audit_record: the audit row of a controlled change (PLT-40, DEC-014).
// It is append-only: the triggers of the migration refuse UPDATE, DELETE and
// TRUNCATE. `actor_user_id` has no foreign key: the row is evidence that stays
// whatever happens to the module that wrote it.
model PlatformAuditRecord {
  id          BigInt               @id @default(autoincrement())
  occurredAt  TimestamptzString(3) @map("occurred_at")
  actorType   String               @map("actor_type")
  actorUserId BigInt?              @map("actor_user_id")
  actionCode  String               @map("action_code")
  entityType  String               @map("entity_type")
  entityId    String               @map("entity_id")
  stateBefore Jsonb?               @map("state_before")
  stateAfter  Jsonb?               @map("state_after")
  reason      String?
  requestId   String?              @map("request_id")

  @@check(expression: sql`(actor_type = ANY (ARRAY['USER'::text, 'SYSTEM'::text]))`, map: "audit_record_actor_type_is_known")
  @@check(expression: sql`((actor_type = 'USER'::text) = (actor_user_id IS NOT NULL))`, map: "audit_record_actor_matches_type")
  @@check(expression: sql`(action_code ~ '^[a-z][a-z0-9_]*[.][a-z][a-z0-9_]*[.][a-z][a-z0-9_]*$'::text)`, map: "audit_record_action_code_form")
  @@index([entityType, entityId], map: "platform_audit_record_entity_idx")
  @@index([occurredAt], map: "platform_audit_record_occurred_at_idx")
  @@map("platform_audit_record")
}

// catalog_product: a product is one stem with one regulatory status (CAT-10,
// DEC-040). `internal_code` is the stem. `name` and `description` hold both
// languages (DEC-011). `regulatory_status` has no default (DEC-041). The row is
// never deleted (DEC-010): the triggers of the migration `catalog` refuse DELETE
// and TRUNCATE.
model CatalogProduct {
  id               BigInt               @id @default(autoincrement())
  internalCode     String               @map("internal_code")
  name             Jsonb
  description      Jsonb?
  regulatoryStatus String               @map("regulatory_status")
  kitCodeBase      String?              @map("kit_code_base")
  isActive         Boolean              @default(true) @map("is_active")
  createdAt        TimestamptzString(3) @map("created_at")
  updatedAt        TimestamptzString(3) @map("updated_at")

  catalogNumbers CatalogCatalogNumber[]
  lotImports     CatalogLotImport[]

  @@unique([internalCode, regulatoryStatus], map: "product_unique_identity")
  @@check(expression: sql`((jsonb_typeof(name) = 'object'::text) AND (jsonb_typeof((name -> 'tr'::text)) = 'string'::text) AND (jsonb_typeof((name -> 'en'::text)) = 'string'::text))`, map: "catalog_product_name_has_both_languages")
  @@check(expression: sql`((description IS NULL) OR ((jsonb_typeof(description) = 'object'::text) AND (jsonb_typeof((description -> 'tr'::text)) = 'string'::text) AND (jsonb_typeof((description -> 'en'::text)) = 'string'::text)))`, map: "catalog_product_description_has_both_languages")
  @@check(expression: sql`(regulatory_status = ANY (ARRAY['IVD'::text, 'RUO'::text]))`, map: "catalog_product_regulatory_status_is_known")
  @@check(expression: sql`(char_length(internal_code) <= 64)`, map: "catalog_product_internal_code_length")
  @@check(expression: sql`((kit_code_base IS NULL) OR (char_length(kit_code_base) <= 32))`, map: "catalog_product_kit_code_base_length")
  @@map("catalog_product")
}

// catalog_catalog_number: a catalog number belongs to one product and is unique
// in the whole catalog (CAT-20, DEC-042). The row is never deleted (DEC-010).
model CatalogCatalogNumber {
  id            BigInt               @id @default(autoincrement())
  productId     BigInt               @map("product_id")
  catalogNumber String               @map("catalog_number")
  packSize      String?              @map("pack_size")
  format        String?
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     TimestamptzString(3) @map("created_at")
  updatedAt     TimestamptzString(3) @map("updated_at")

  product CatalogProduct @relation(fields: [productId], references: [id], onDelete: Restrict, map: "catalog_catalog_number_product_fk")
  lots    CatalogLot[]

  @@unique([catalogNumber], map: "catalog_number_unique")
  @@check(expression: sql`(char_length(catalog_number) <= 64)`, map: "catalog_catalog_number_length")
  @@check(expression: sql`((pack_size IS NULL) OR (char_length(pack_size) <= 32))`, map: "catalog_catalog_number_pack_size_length")
  @@check(expression: sql`((format IS NULL) OR (format = ANY (ARRAY['VCAP'::text, 'LYOPHILIZED'::text, 'LIQUID'::text])))`, map: "catalog_catalog_number_format_is_known")
  @@index([productId], map: "catalog_catalog_number_product_idx")
  @@map("catalog_catalog_number")
}

// catalog_lot: a LOT belongs to one catalog number (CAT-40, DEC-045). The dates
// are business dates (DEC-039): the column type carries the text YYYY-MM-DD, so
// no time zone moves a date. `lot_number_idx` serves the one lookup of DEC-045.
// The row is never deleted (DEC-010).
model CatalogLot {
  id                        BigInt               @id @default(autoincrement())
  catalogNumberId           BigInt               @map("catalog_number_id")
  lotNumber                 String               @map("lot_number")
  manufacturingDate         DateString           @map("manufacturing_date")
  manufacturingDateSource   String               @map("manufacturing_date_source")
  suppliedManufacturingDate DateString?          @map("supplied_manufacturing_date")
  expiryDate                DateString?          @map("expiry_date")
  hasDateConflict           Boolean              @default(false) @map("has_date_conflict")
  lotImportId               BigInt?              @map("lot_import_id")
  createdAt                 TimestamptzString(3) @map("created_at")
  updatedAt                 TimestamptzString(3) @map("updated_at")

  catalogNumber CatalogCatalogNumber  @relation(fields: [catalogNumberId], references: [id], onDelete: Restrict, map: "catalog_lot_catalog_number_fk")
  lotImport     CatalogLotImport?     @relation(fields: [lotImportId], references: [id], onDelete: Restrict, map: "catalog_lot_lot_import_fk")
  importRows    CatalogLotImportRow[]

  @@unique([catalogNumberId, lotNumber], map: "lot_unique_per_catalog_number")
  @@check(expression: sql`((expiry_date IS NULL) OR (expiry_date > manufacturing_date))`, map: "lot_expiry_after_manufacturing")
  @@check(expression: sql`(manufacturing_date_source = ANY (ARRAY['PARSED_FROM_LOT'::text, 'SUPPLIED'::text, 'MANUAL_CORRECTION'::text]))`, map: "catalog_lot_manufacturing_date_source_is_known")
  @@check(expression: sql`(char_length(lot_number) <= 64)`, map: "catalog_lot_lot_number_length")
  @@index([lotNumber], map: "lot_number_idx")
  @@index([lotImportId], map: "catalog_lot_lot_import_idx")
  @@map("catalog_lot")
}

// catalog_lot_import: one commit of a LOT import (CAT-60). `uploaded_by_user_id`
// holds the user id and has no foreign key to identity_user: a module reads
// another module only through its service (DEC-004). The row is never deleted
// (DEC-010).
model CatalogLotImport {
  id               BigInt                @id @default(autoincrement())
  sourceFilename   String?               @map("source_filename")
  sourceHash       String                @map("source_hash")
  productId        BigInt?               @map("product_id")
  uploadedByUserId BigInt                @map("uploaded_by_user_id")
  status           String
  rowCount         Int                   @map("row_count")
  createdCount     Int                   @map("created_count")
  existingCount    Int                   @map("existing_count")
  conflictCount    Int                   @map("conflict_count")
  invalidCount     Int                   @map("invalid_count")
  failureCode      String?               @map("failure_code")
  createdAt        TimestamptzString(3)  @map("created_at")
  completedAt      TimestamptzString(3)? @map("completed_at")

  product CatalogProduct?       @relation(fields: [productId], references: [id], onDelete: Restrict, map: "catalog_lot_import_product_fk")
  lots    CatalogLot[]
  rows    CatalogLotImportRow[]

  @@check(expression: sql`(status = ANY (ARRAY['PROCESSING'::text, 'COMPLETED'::text, 'FAILED'::text]))`, map: "catalog_lot_import_status_is_known")
  @@check(expression: sql`((status <> 'COMPLETED'::text) OR ((((created_count + existing_count) + conflict_count) + invalid_count) = row_count))`, map: "lot_import_counts_add_up")
  @@check(expression: sql`((failure_code IS NULL) OR (status = 'FAILED'::text))`, map: "catalog_lot_import_failure_code_only_when_failed")
  @@check(expression: sql`((row_count >= 0) AND (created_count >= 0) AND (existing_count >= 0) AND (conflict_count >= 0) AND (invalid_count >= 0))`, map: "catalog_lot_import_counts_not_negative")
  @@index([sourceHash], map: "catalog_lot_import_source_hash_idx")
  @@map("catalog_lot_import")
}

// catalog_lot_import_row: one row of an import with its outcome and reason
// (CAT-60 rule 6). `raw_cells` keeps the cells as they arrived (rule 10). The
// row is never deleted (DEC-010).
model CatalogLotImportRow {
  id          BigInt  @id @default(autoincrement())
  lotImportId BigInt  @map("lot_import_id")
  rowNumber   Int     @map("row_number")
  outcome     String
  reason      String?
  rawCells    Jsonb   @map("raw_cells")
  lotId       BigInt? @map("lot_id")

  lotImport CatalogLotImport @relation(fields: [lotImportId], references: [id], onDelete: Restrict, map: "catalog_lot_import_row_lot_import_fk")
  lot       CatalogLot?      @relation(fields: [lotId], references: [id], onDelete: Restrict, map: "catalog_lot_import_row_lot_fk")

  @@unique([lotImportId, rowNumber], map: "lot_import_row_unique")
  @@check(expression: sql`(row_number >= 1)`, map: "catalog_lot_import_row_number_from_one")
  @@check(expression: sql`(outcome = ANY (ARRAY['CREATED'::text, 'ALREADY_EXISTS'::text, 'CONFLICT_REVIEW_REQUIRED'::text, 'INVALID_CATALOG_NUMBER'::text, 'INVALID_LOT_FORMAT'::text, 'INVALID_DATE'::text]))`, map: "catalog_lot_import_row_outcome_is_known")
  @@check(expression: sql`((reason IS NULL) OR (reason = ANY (ARRAY['LOT_ALREADY_EXISTS'::text, 'DUPLICATE_ROW'::text, 'DATE_DIFFERS_FROM_REGISTERED'::text, 'SUPPLIED_DATE_CONFLICT'::text, 'KIT_CODE_MISMATCH'::text, 'CONFLICTING_ROWS'::text, 'CATALOG_NUMBER_NOT_FOUND'::text, 'OTHER_PRODUCT'::text, 'LOT_MISSING'::text, 'LOT_FORMAT_INVALID'::text, 'LOT_DATE_INVALID'::text, 'SUPPLIED_DATE_INVALID'::text])))`, map: "catalog_lot_import_row_reason_is_known")
  @@index([lotId], map: "catalog_lot_import_row_lot_idx")
  @@map("catalog_lot_import_row")
}
