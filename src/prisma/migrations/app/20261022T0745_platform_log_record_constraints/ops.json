    "execute": [
      {
        "description": "add check constraint \"log_record_message_length\"",
        "sql": "ALTER TABLE \"public\".\"platform_log_record\" ADD CONSTRAINT \"log_record_message_length\" CHECK ((char_length(message) <= 8192))"
