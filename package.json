{
  "name": "bioeksen-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run --project unit --project component",
    "test:integration": "vitest run --project integration",
    "test:pipeline": "vitest run --project pipeline",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --config tests/smoke/playwright.config.ts",
    "test:results": "node --no-warnings tests/support/results.ts",
    "prebuild": "prisma contract emit",
    "build": "next build",
    "start": "next start",
    "contract:emit": "prisma contract emit",
    "db:migrate": "prisma db migrate",
    "db:check": "node --no-warnings src/scripts/db-check.ts",
    "specs:check": "node --no-warnings src/scripts/specs-check.ts",
    "deps:audit": "pnpm audit --audit-level high",
    "toolchain:check": "node --no-warnings src/scripts/toolchain-check.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@prisma/orm-postgres": "8.0.0-rc.18",
    "dotenv": "^18.0.8",
    "jose": "^6.2.13",
    "next": "16.4.2",
    "nodemailer": "^10.1.7",
    "pg": "8.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "^6.3.0",
    "server-only": "^0.0.1",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@prisma/cli-engine": "0.7.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/pg": "8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "prisma": "8.0.0-rc.23",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.11.2"
}
